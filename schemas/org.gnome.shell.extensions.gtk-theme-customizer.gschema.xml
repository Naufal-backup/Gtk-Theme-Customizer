<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gtk-theme-customizer" path="/org/gnome/shell/extensions/gtk-theme-customizer/">
    
    <!-- Global Style Settings -->
    <key name="icon-size" type="i">
      <default>30</default>
      <summary>Icon Size</summary>
      <description>Size of the window control icons in pixels</description>
    </key>
    
    <key name="border-radius" type="i">
      <default>999</default>
      <summary>Border Radius</summary>
      <description>Border radius of window control buttons</description>
    </key>
    
    <key name="button-padding" type="i">
      <default>5</default>
      <summary>Button Padding</summary>
      <description>Padding inside the button around the icon</description>
    </key>
    
    <key name="button-margin" type="s">
      <default>'2px 4px 2px 4px'</default>
      <summary>Button Margin</summary>
      <description>Margin around the buttons (CSS format)</description>
    </key>
    
    <key name="button-bg-color" type="s">
      <default>'#ffffff'</default>
      <summary>Button Background Color</summary>
      <description>Default background color for all buttons</description>
    </key>

    <key name="header-max-height" type="i">
      <default>46</default>
      <summary>Header Max Height</summary>
      <description>Maximum height for headerbar (applies to both GTK 3 and GTK 4)</description>
    </key>

    <key name="titlebar-text-mode" type="s">
      <default>'show'</default>
      <summary>Titlebar Text Mode</summary>
      <description>Control titlebar text display: 'show' (show title), 'hide' (hide title), or 'wmclass' (show app name from wmclass)</description>
    </key>
    
    <!-- GTK 4 Specific Settings -->
    <key name="gtk4-min-height" type="i">
      <default>32</default>
      <summary>GTK 4 Button Min Height</summary>
      <description>Minimum height for GTK 4 window control buttons</description>
    </key>
    
    <key name="gtk4-min-width" type="i">
      <default>32</default>
      <summary>GTK 4 Button Min Width</summary>
      <description>Minimum width for GTK 4 window control buttons</description>
    </key>
    
    <key name="gtk4-margin-top" type="i">
      <default>2</default>
      <summary>GTK 4 Margin Top</summary>
      <description>Top margin for GTK 4 buttons</description>
    </key>
    
    <key name="gtk4-margin-bottom" type="i">
      <default>2</default>
      <summary>GTK 4 Margin Bottom</summary>
      <description>Bottom margin for GTK 4 buttons</description>
    </key>
    
    <key name="gtk4-margin-left" type="i">
      <default>4</default>
      <summary>GTK 4 Margin Left</summary>
      <description>Left margin for GTK 4 buttons</description>
    </key>
    
    <key name="gtk4-margin-right" type="i">
      <default>4</default>
      <summary>GTK 4 Margin Right</summary>
      <description>Right margin for GTK 4 buttons</description>
    </key>

    <key name="gtk4-use-custom-icons" type="b">
      <default>false</default>
      <summary>Use Custom Icons (GTK 4)</summary>
    </key>
    <key name="gtk4-close-icon-path" type="s"><default>''</default></key>
    <key name="gtk4-close-icon-svg" type="s"><default>''</default></key>
    <key name="gtk4-close-icon-size" type="i"><default>30</default></key>
    <key name="gtk4-minimize-icon-path" type="s"><default>''</default></key>
    <key name="gtk4-minimize-icon-svg" type="s"><default>''</default></key>
    <key name="gtk4-minimize-icon-size" type="i"><default>30</default></key>
    <key name="gtk4-maximize-icon-path" type="s"><default>''</default></key>
    <key name="gtk4-maximize-icon-svg" type="s"><default>''</default></key>
    <key name="gtk4-maximize-icon-size" type="i"><default>30</default></key>
    
    <!-- GTK 3 Specific Settings -->
    <key name="gtk3-min-height" type="i">
      <default>38</default>
      <summary>GTK 3 Button Min Height</summary>
      <description>Minimum height for GTK 3 window control buttons</description>
    </key>
    
    <key name="gtk3-min-width" type="i">
      <default>38</default>
      <summary>GTK 3 Button Min Width</summary>
      <description>Minimum width for GTK 3 window control buttons</description>
    </key>
    
    <key name="gtk3-margin-top" type="i">
      <default>2</default>
      <summary>GTK 3 Margin Top</summary>
      <description>Top margin for GTK 3 buttons</description>
    </key>
    
    <key name="gtk3-margin-bottom" type="i">
      <default>2</default>
      <summary>GTK 3 Margin Bottom</summary>
      <description>Bottom margin for GTK 3 buttons</description>
    </key>
    
    <key name="gtk3-margin-left" type="i">
      <default>2</default>
      <summary>GTK 3 Margin Left</summary>
      <description>Left margin for GTK 3 buttons</description>
    </key>
    
    <key name="gtk3-margin-right" type="i">
      <default>0</default>
      <summary>GTK 3 Margin Right</summary>
      <description>Right margin for GTK 3 buttons</description>
    </key>
    
    <key name="gtk3-icon-scale" type="d">
      <default>1.6</default>
      <range min="0.5" max="3.0"/>
      <summary>GTK 3 Icon Scale</summary>
      <description>Scale factor for GTK 3 button icons</description>
    </key>

    <key name="gtk3-use-custom-icons" type="b">
      <default>false</default>
      <summary>Use Custom Icons (GTK 3)</summary>
    </key>
    <key name="gtk3-close-icon-path" type="s"><default>''</default></key>
    <key name="gtk3-close-icon-svg" type="s"><default>''</default></key>
    <key name="gtk3-close-icon-size" type="i"><default>30</default></key>
    <key name="gtk3-minimize-icon-path" type="s"><default>''</default></key>
    <key name="gtk3-minimize-icon-svg" type="s"><default>''</default></key>
    <key name="gtk3-minimize-icon-size" type="i"><default>30</default></key>
    <key name="gtk3-maximize-icon-path" type="s"><default>''</default></key>
    <key name="gtk3-maximize-icon-svg" type="s"><default>''</default></key>
    <key name="gtk3-maximize-icon-size" type="i"><default>30</default></key>

    <!-- Global Custom Icon Settings -->
    <key name="custom-icon-opacity" type="d">
      <default>1.0</default>
      <range min="0.0" max="1.0"/>
      <summary>Custom Icon Opacity</summary>
    </key>
    
    <key name="custom-icon-hover-opacity" type="d">
      <default>0.8</default>
      <range min="0.0" max="1.0"/>
      <summary>Custom Icon Hover Opacity</summary>
    </key>
    
    <key name="custom-icon-hover-brightness" type="d">
      <default>1.0</default>
      <range min="0.0" max="3.0"/>
      <summary>Custom Icon Hover Brightness</summary>
    </key>
    
    <!-- Button Colors (shared icons colors) -->
    <key name="close-icon-color" type="s"><default>'#FFFFFF'</default></key>
    <key name="close-hover-icon-color" type="s"><default>'#FFFFFF'</default></key>
    <key name="minimize-icon-color" type="s"><default>'#000000'</default></key>
    <key name="minimize-hover-icon-color" type="s"><default>'#000000'</default></key>
    <key name="maximize-icon-color" type="s"><default>'#FFFFFF'</default></key>
    <key name="maximize-hover-icon-color" type="s"><default>'#FFFFFF'</default></key>

    <!-- Deprecated/Removed but kept for schema stability during dev if needed, or removed if clean install -->
    <!-- I'll keep only what's necessary for the current logic -->
    
  </schema>
</schemalist>
